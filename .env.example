# =============================================================================
# WealthView TH — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local
# =============================================================================

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Project URL and anon key from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — used by background jobs / Trigger.dev only.
# DO NOT expose to client. Found in Supabase Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
# Create a project at https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for source-map upload (Settings → Auth Tokens, scope: project:releases)
SENTRY_AUTH_TOKEN=

# ─── Trigger.dev (background jobs) ────────────────────────────────────────────
# Sign up at https://trigger.dev → Create project → API Keys
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
# For local dev: pnpm dlx trigger.dev@latest dev

# ─── Logging ──────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Resend (transactional email) ────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@wealthview.th

# ─── PostHog (product analytics) ──────────────────────────────────────────────
# https://posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Stripe (subscription billing) ────────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for premium plans (Products → pick plan → Price ID)
STRIPE_PRICE_ID_PREMIUM_MONTHLY=
STRIPE_PRICE_ID_PREMIUM_YEARLY=

# ─── Market Data Providers (optional — fallback to public APIs if empty) ─────
# CoinGecko Pro key (https://coingecko.com/api/pricing) — optional, public free tier ok
COINGECKO_API_KEY=

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Toggle features without redeploy. Use "true"/"false".
FEATURE_RETIREMENT_ENABLED=true
FEATURE_PORTFOLIO_ENABLED=true
FEATURE_FAMILY_SHARING_ENABLED=false
